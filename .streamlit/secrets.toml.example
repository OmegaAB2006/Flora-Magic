# Example Streamlit secrets file — copy to .streamlit/secrets.toml
# and fill in your real credentials (never commit the real file to git).

IBM_API_KEY      = "your-ibm-cloud-api-key"
IBM_PROJECT_ID   = "your-watsonx-project-id"
IBM_SERVICE_URL  = "https://us-south.ml.cloud.ibm.com"
VISION_MODEL_ID  = "ibm/granite-vision-3-3-2b"
ADVISORY_MODEL_ID = "ibm/granite-4-h-small"
